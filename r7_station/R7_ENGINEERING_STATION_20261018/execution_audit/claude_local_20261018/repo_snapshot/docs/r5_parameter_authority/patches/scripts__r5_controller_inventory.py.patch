+def resolve_line(commit: str, path: str, anchor: str):
+    try:
+        text = subprocess.run(["git", "show", f"{commit}:{path}"], cwd=ROOT, capture_output=True, text=True, check=True).stdout
+    except subprocess.CalledProcessError:
+        return None
+    for number, line in enumerate(text.splitlines(), 1):
+        if anchor in line:
+            return number
+    return None
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--commit", default="cb10fac")
+    parser.add_argument("--json", type=Path, required=True)
+    parser.add_argument("--md", type=Path, required=True)
+    args = parser.parse_args()
+    rows = []
+    for entry in CONTROLLERS:
+        row = dict(entry)
+        row["line"] = resolve_line(args.commit, entry["file"], entry["anchor"])
+        row["location"] = f"{entry['file']}:{row['line']}"
+        rows.append(row)
+    missing = [r["id"] for r in rows if r["line"] is None]
+    if missing:
+        raise SystemExit(f"unresolved anchors: {missing}")
+    doc = {"inventory": "R5_CONTROLLER_INVENTORY", "commit": args.commit,
+           "engines": "A (revision2_external orchestrator + paper broker), B (engine_b subclass, Nautilus), C (engine_c subclass, Backtrader): identical controller objects",
+           "controllers": rows}
+    args.json.parent.mkdir(parents=True, exist_ok=True)
+    args.json.write_text(json.dumps(doc, indent=2) + "\n")
+    out = [f"# R5 controller inventory (at {args.commit})", "",
+           "Engines B and C subclass the Engine A orchestrator and override only execution seams, so every controller "
+           "below is the same code and the same instances in all three engines.", "",
+           "| ID | Controller | Location | Scope | Status | Actuator |", "|---|---|---|---|---|---|"]
+    for r in rows:
+        out.append(f"| {r['id']} | {r['name']} | `{r['location']}` | {r['scope']} | {r['status']} | {r['actuator']} |")
+    for r in rows:
+        out += ["", f"## {r['id']} {r['name']}", "", f"- Source: `{r['location']}` ({r['symbol']})", f"- Instances: {r['instances']}",
+                f"- Scope: {r['scope']}", f"- Input: {r['input']}", f"- Setpoint: {r['setpoint']}", f"- Error: {r['error']}",
+                f"- P: {r['p']}", f"- I: {r['i']}", f"- D: {r['d']}", f"- Clamp: {r['clamp']}", f"- Output limits: {r['output_limits']}",
+                f"- Reset: {r['reset']}", f"- Update frequency: {r['update']}", f"- State persistence: {r['persistence']}",
+                f"- Runtime actuator: {r['actuator']}", f"- Registry parameters: {', '.join(r['registry']) or 'none'}",
+                f"- Hardcoded values: {'; '.join(r['hardcoded']) or 'none'}", f"- Tests: {r['tests']}", f"- Status: **{r['status']}**"]
+        if r.get("note"):
+            out.append(f"- Note: {r['note']}")
+    args.md.write_text("\n".join(out) + "\n")
+    print(f"{len(rows)} controllers -> {args.json}, {args.md}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
