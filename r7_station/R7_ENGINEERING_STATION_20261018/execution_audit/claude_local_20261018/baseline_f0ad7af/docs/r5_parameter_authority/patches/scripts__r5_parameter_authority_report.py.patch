diff --git a/scripts/r5_parameter_authority_report.py b/scripts/r5_parameter_authority_report.py
new file mode 100644
index 0000000..4170f91
--- /dev/null
+++ b/scripts/r5_parameter_authority_report.py
@@ -0,0 +1,128 @@
+"""Generate the parameter-authority deliverables from the code itself (never hand-maintained):
+
+* PARAMETER_OWNERSHIP_MATRIX.csv / .md  every controller parameter: type, default, bounds, class,
+                                        calibration status, owner, consumer, former literal location
+                                        (cb10fac) and the sensitivity test that proves it
+* REGISTRY_ADDITIONS.json               the complete registry rows added, with the new identity
+* patches/*.patch                       one unified diff per changed file against cb10fac
+
+    PYTHONPATH="$PWD" python scripts/r5_parameter_authority_report.py --out docs/r5_parameter_authority
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import subprocess
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from canonical_parameter_registry import CanonicalParameterRegistry  # noqa: E402
+from revision5.controller_parameters import (  # noqa: E402
+    ADVISORY, CONTROLLER_PARAMETER_SPECS, FIXED_SAFETY, INACTIVE, TUNABLE,
+)
+
+BASE = "cb10fac"
+
+# Former literal location at cb10fac, by parameter-name prefix (longest prefix wins).
+FORMER_LOCATION = {
+    "gov_": "revision5/governor.py:59-125 BAY_GOVERNOR_SPECS / :47-56 BayGovernorSpec defaults / :921 feedback -0.25",
+    "gov_v3_": "not present at cb10fac (ported from a695913 research/r5-step0-correctness)",
+    "gsch_": "revision5/dynamic_parameters.py:613-758 governor schedule",
+    "dyn_": "revision5/dynamic_parameters.py:348 (vol clip), :380-394 (stress, risk derate)",
+    "plant_loss_cooldown": "revision5/ccpp_unified_plant.py:73 LOSS_COOLDOWN_BARS; revision5/dynamic_parameters.py:455-466",
+    "plant_target_cooldown": "revision5/ccpp_unified_plant.py:74 TARGET_COOLDOWN_BARS; revision5/dynamic_parameters.py:468-479",
+    "plant_bay_lockout": "revision5/ccpp_unified_plant.py:1215 consecutive_stops >= 2",
+    "plant_stop_floor": "revision5/ccpp_unified_plant.py:1044 price * 0.0065",
+    "plant_target_min": "revision5/ccpp_unified_plant.py:1049 stop_distance * 1.5",
+    "symbol_loss_cooldown": "revision2_external/orchestrator.py:94 BAY_LOSS_COOLDOWN_BARS = 15",
+    "symbol_trip": "revision2_external/orchestrator.py:~1430 _c_losses >= 2",
+    "avr_": "revision5/ccpp_protection_cubicles.py:157-215 BayExcitationAVR.__init__; revision5/dynamic_parameters.py:79-181, 775-824; revision5/ccpp_unified_plant.py:258-263",
+    "avr_voltage": "new (measured terminal-voltage path; no former literal: the voltage was never supplied)",
+    "avr_synchronous": "new (measured terminal-voltage path)",
+    "sel_": "revision5/ccpp_protection_cubicles.py:753-765 BayUnitProtectionSEL300G; revision5/dynamic_parameters.py:826-889",
+    "micom_": "revision5/ccpp_protection_cubicles.py:31-36 MasterGridProtectionMiCOM (+:129 1.5x over-frequency); revision5/dynamic_parameters.py:891-926",
+    "disp_": "revision5/ccpp_unified_plant.py:91-218 DynamicBayLoadDispatcher",
+    "hrsg_": "revision5/hrsg.py:106-118 HeatRecoverySteamGenerator.__init__ defaults",
+}
+
+TEST_FILE = "tests/test_r5_parameter_authority.py"
+
+
+def former_location(name: str) -> str:
+    best = max((p for p in FORMER_LOCATION if name.startswith(p)), key=len, default=None)
+    return FORMER_LOCATION.get(best, "")
+
+
+def proof(spec) -> str:
+    if spec.name.startswith("symbol_"):
+        return f"tests/test_r5_parameter_authority_engines.py::test_symbol_loss_cooldown_and_trip_count_change_entry_admission"
+    return f"{TEST_FILE}::test_every_parameter_sensitivity_matches_its_class[{spec.name}]"
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    out = args.out
+    out.mkdir(parents=True, exist_ok=True)
+    registry = CanonicalParameterRegistry()
+    registry.verify_frozen_identity()
+
+    rows = []
+    for spec in sorted(CONTROLLER_PARAMETER_SPECS, key=lambda s: s.name):
+        rows.append({
+            "name": spec.name, "type": spec.param_type, "default": spec.default, "minimum": spec.minimum,
+            "maximum": spec.maximum, "applicability": spec.applicability, "safety_class": spec.safety_class,
+            "optimizer_eligible": registry.is_calibratable(spec.name, "EXTERNAL"), "calibration_status": spec.calibration_status,
+            "owning_controller": spec.owner, "consumer": spec.consumer, "former_literal_location_cb10fac": former_location(spec.name),
+            "sensitivity_proof": proof(spec), "description": spec.description,
+        })
+    with open(out / "PARAMETER_OWNERSHIP_MATRIX.csv", "w", newline="") as fh:
+        writer = csv.DictWriter(fh, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+    counts = {cls: sum(1 for r in rows if r["safety_class"] == cls) for cls in (TUNABLE, FIXED_SAFETY, ADVISORY, INACTIVE)}
+    md = ["# R5 controller parameter ownership matrix", "",
+          f"Generated by `scripts/r5_parameter_authority_report.py` from `revision5/controller_parameters.py`. "
+          f"{len(rows)} parameters: " + ", ".join(f"{v} {k}" for k, v in counts.items()) + ".", "",
+          f"Registry identity `{registry.FROZEN_IDENTITY_SHA256}` (supersedes `12b700d6caa88b76...`).", "",
+          "| Parameter | Type | Default | Bounds | Class | Owner | Consumer | Former literal (cb10fac) |",
+          "|---|---|---|---|---|---|---|---|"]
+    for r in rows:
+        md.append(f"| `{r['name']}` | {r['type']} | {r['default']} | [{r['minimum']}, {r['maximum']}] | {r['safety_class']} | "
+                  f"{r['owning_controller']} | {r['consumer']} | {r['former_literal_location_cb10fac']} |")
+    (out / "PARAMETER_OWNERSHIP_MATRIX.md").write_text("\n".join(md) + "\n")
+
+    additions = {
+        "registry_identity_sha256": registry.FROZEN_IDENTITY_SHA256,
+        "superseded_identity_sha256": "12b700d6caa88b7689daf825ff4c512e0513dcb59de1a3c96cf693a820aa277d",
+        "surface_counts": registry.surface_counts(),
+        "controller_parameter_counts": counts,
+        "registry_rows": [{"name": s.name, "black_box": registry.params[s.name].black_box,
+                           "param_type": s.param_type, "default": s.default, "minimum": s.minimum, "maximum": s.maximum,
+                           "calibratable": registry.is_calibratable(s.name, "EXTERNAL"),
+                           "applicable_engines": registry.params[s.name].applicable_engines,
+                           "notes": registry.params[s.name].notes, "safety_class": s.safety_class,
+                           "calibration_status": s.calibration_status, "owner": s.owner, "consumer": s.consumer}
+                          for s in sorted(CONTROLLER_PARAMETER_SPECS, key=lambda s: s.name)],
+    }
+    (out / "REGISTRY_ADDITIONS.json").write_text(json.dumps(additions, indent=2) + "\n")
+
+    patches = out / "patches"
+    patches.mkdir(exist_ok=True)
+    changed = subprocess.run(["git", "diff", "--name-only", BASE, "--", ".", ":!docs/r5_parameter_authority"],
+                             cwd=ROOT, capture_output=True, text=True, check=True).stdout.split()
+    for path in changed:
+        diff = subprocess.run(["git", "diff", BASE, "--", path], cwd=ROOT, capture_output=True, text=True, check=True).stdout
+        (patches / (path.replace("/", "__") + ".patch")).write_text(diff)
+    (out / "CHANGED_FILES.txt").write_text("\n".join(changed) + "\n")
+    print(f"{len(rows)} parameters, {len(changed)} changed files -> {out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
