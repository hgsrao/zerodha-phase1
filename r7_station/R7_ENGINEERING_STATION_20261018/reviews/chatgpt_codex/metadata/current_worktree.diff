+R7_DECISION_MEMORY_LIMIT = 1000
+
 
 class _StudiesTap:
     """Forward studies calls unchanged and retain only their current causal bar."""
@@ -72,7 +74,10 @@ class R7EngineMixin:
         # rolling SHA-256 chain, so their size does not grow with replay length.
