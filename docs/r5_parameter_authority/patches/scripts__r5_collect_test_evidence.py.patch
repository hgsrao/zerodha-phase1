+"""Collect the verification evidence (JUnit XML + golden-gate logs) into TEST_RESULTS.json.
+
+    python scripts/r5_collect_test_evidence.py --dir RESULTS_DIR --commit SHA --out docs/r5_parameter_authority/TEST_RESULTS.json
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+
+def junit(path: Path):
+    root = ET.parse(path).getroot()
+    suites = [root] if root.tag == "testsuite" else list(root)
+    totals = {k: sum(int(s.get(k, 0)) for s in suites) for k in ("tests", "failures", "errors", "skipped")}
+    failed, sweep = [], {"tests": 0, "failed": 0}
+    for case in root.iter("testcase"):
+        name = f"{case.get('classname')}::{case.get('name')}"
+        bad = case.find("failure") is not None or case.find("error") is not None
+        if bad:
+            failed.append(name)
+        if "test_every_parameter_sensitivity_matches_its_class" in name:
+            sweep["tests"] += 1
+            sweep["failed"] += int(bad)
+    totals["passed"] = totals["tests"] - totals["failures"] - totals["errors"] - totals["skipped"]
+    return {**totals, "failed_tests": failed, "parameter_sweep": sweep}
+
+
+def last_line(path: Path, pattern: str):
+    lines = [l for l in path.read_text().splitlines() if re.search(pattern, l)] if path.exists() else []
+    return lines[-1] if lines else None
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dir", type=Path, required=True)
+    parser.add_argument("--commit", required=True)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    d = args.dir
+    evidence = {
+        "commit": args.commit,
+        "environment": "operator desktop, ~/.venvs/zerodha-phase1-r5 (Python 3.12.14)",
+        "suites": {name: junit(d / f"{name}.xml") for name in ("tests_main", "engine_b", "engine_c") if (d / f"{name}.xml").exists()},
+        "golden_master": {
+            "local_byte_level_vs_cb10fac": last_line(d / "gate.local", "GOLDEN MASTER"),
+            "local_identity_fields_changed": last_line(d / "gate.local", "identity-only"),
+            "decision_level_vs_stored_500abab": last_line(d / "gate.decisions", "GOLDEN MASTER"),
+            "stored_byte_level_500abab": last_line(d / "golden_stored.log", "GOLDEN MASTER"),
+            "stored_byte_level_note": "fails identically at untouched cb10fac on this machine (HMM last-digit float drift); decisions identical",
+        },
+        "commands": {
+            "tests_main": "PYTHONPATH=$PWD python -m pytest tests tests_external --ignore=tests/legacy_quarantine",
+            "engine_b": "PYTHONPATH=$PWD python -m pytest tests_engine_b",
+            "engine_c": "ENGINE_C_SKIP_GOLDEN_MASTER=1 PYTHONPATH=$PWD python -m pytest tests_engine_c",
+            "local_gate": "PYTHONPATH=$PWD python scripts/r5_golden_master_local.py --check-local local_workspace/golden_local/cb10fac",
+            "decision_gate": "PYTHONPATH=$PWD python scripts/r5_golden_master_local.py --check-decisions",
+        },
+    }
+    args.out.write_text(json.dumps(evidence, indent=2) + "\n")
+    print(json.dumps({k: {kk: vv for kk, vv in v.items() if kk != "failed_tests"} if isinstance(v, dict) else v
+                      for k, v in evidence["suites"].items()}, indent=1))
+    print(json.dumps(evidence["golden_master"], indent=1))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
